# Copy to .env.local for local development, and add the same variables in your
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# --- Contact form (required for messages to actually be delivered) -----------
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Where messages are delivered. Defaults to the email in src/data/site.ts.
# With Resend's shared test sender this MUST be the email your Resend account
# was created with, until you verify your own domain.
CONTACT_TO_EMAIL=

# Optional. Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Once you verify a domain in Resend, use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# --- Site URL (used for SEO: canonical links, sitemap, social previews) -------
# On Vercel this is detected automatically; set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- GitHub activity section (optional) --------------------------------------
# Unauthenticated GitHub API calls are limited to 60/hour per IP. A token with
# no scopes (public data only) raises that to 5,000/hour.
GITHUB_TOKEN=
